{
  "template_id": "tec_metering_advanced",
  "template_name": "收费入口 - 时变限流",
  "description": "高级匝道流量控制，支持4+个时间段的精细流量管理，匹配实际交通需求曲线（夜间低→早高峰最低→白天中→晚高峰低→夜间低）。每个时段包含流量和入口速度的独立配置。",
  "strategy_type": "TEC",
  "sumo_element": "calibrator",
  "version": "2.0",
  "parameters_schema": [
    {
      "parameter_name": "entrance_edge",
      "parameter_type": "string",
      "description": "入口匝道edge ID（单一entrance）",
      "required": true,
      "default_value": "",
      "unit": null,
      "sumo_mapping": "edge 属性"
    },
    {
      "parameter_name": "position",
      "parameter_type": "number",
      "description": "Calibrator位置（通常为0=入口起点）",
      "required": false,
      "default_value": 0,
      "min_value": 0,
      "max_value": 1000,
      "unit": "米"
    },
    {
      "parameter_name": "flow_intervals",
      "parameter_type": "flow_interval_array",
      "description": "4个及以上精细的流量控制时间段（实现时变控制，最少4个时段）",
      "required": true,
      "default_value": [
        {
          "begin_hours": 0,
          "end_hours": 7,
          "vehsPerHour": 480,
          "target_speed": 15
        },
        {
          "begin_hours": 7,
          "end_hours": 9,
          "vehsPerHour": 180,
          "target_speed": 8
        },
        {
          "begin_hours": 9,
          "end_hours": 17,
          "vehsPerHour": 480,
          "target_speed": 15
        },
        {
          "begin_hours": 17,
          "end_hours": 19,
          "vehsPerHour": 300,
          "target_speed": 10
        },
        {
          "begin_hours": 19,
          "end_hours": 24,
          "vehsPerHour": 480,
          "target_speed": 15
        }
      ],
      "unit": null,
      "constraints": {
        "min_intervals": 4,
        "max_intervals": 10
      },
      "interval_structure": {
        "begin_display_unit": "hours",
        "begin_sumo_unit": "seconds",
        "begin_conversion_factor": 3600,
        "end_display_unit": "hours",
        "end_sumo_unit": "seconds",
        "end_conversion_factor": 3600,
        "vehsPerHour_display_unit": "vehicles/hour",
        "vehsPerHour_constraints": {"min": 0, "max": 2000},
        "target_speed_display_unit": "m/s",
        "target_speed_constraints": {"min": 5, "max": 20}
      },
      "sumo_element": "flow",
      "sumo_attributes": ["begin", "end", "vehsPerHour", "speed"]
    },
    {
      "parameter_name": "metering_strategy",
      "parameter_type": "enum",
      "description": "流量控制策略（仅用于文档）",
      "required": false,
      "default_value": "time_based",
      "enum_values": [
        {"value": "time_based", "label": "基于时间的固定流量"},
        {"value": "adaptive", "label": "自适应（需手动调整）"}
      ]
    }
  ],
  "visualization_guidance": {
    "description": "建议在UI中显示流量曲线可视化",
    "graph_type": "折线图",
    "x_axis": "时间（小时，0-24）",
    "y_axis": "流量（vehicles/hour，0-600）",
    "typical_pattern": "U形曲线：低→高→低→中→低"
  },
  "implementation_note": {
    "description": "此模板与tec_metering基础模板类似，但默认包含5个时间段，实现更精细的日内流量管理",
    "use_case": "适合需要精确匹配需求曲线的入口控制场景"
  },
  "created_at": "2025-10-24T12:00:00Z",
  "updated_at": "2025-10-24T12:00:00Z"
}
