{
  "template_id": "tec_emergency_closure",
  "template_name": "收费入口 - 紧急关闭",
  "description": "紧急情况下完全关闭一个或多个收费站入口，所有车辆都被禁止进入并自动重新路由。仅用于严重交通事故、设施故障、自然灾害等应急情况，不适合日常流量管理。",
  "strategy_type": "TEC",
  "sumo_element": "rerouter",
  "version": "2.0",
  "parameters_schema": [
    {
      "parameter_name": "entrance_edges",
      "parameter_type": "edge_array",
      "description": "要紧急关闭的入口edge ID列表（支持多个入口）",
      "required": true,
      "default_value": [],
      "unit": null,
      "sumo_mapping": "edges (直接使用)"
    },
    {
      "parameter_name": "closure_intervals",
      "parameter_type": "tec_interval_array",
      "description": "紧急关闭的时间区间列表（建议每次关闭1-4小时）",
      "required": true,
      "default_value": [
        {"begin_hours": 7, "end_hours": 9}
      ],
      "unit": null,
      "constraints": {
        "min_intervals": 1,
        "max_intervals": 10,
        "recommended_duration_hours": "1-4"
      },
      "interval_structure": {
        "begin_display_unit": "hours",
        "begin_sumo_unit": "seconds",
        "begin_conversion_factor": 3600,
        "end_display_unit": "hours",
        "end_sumo_unit": "seconds",
        "end_conversion_factor": 3600
      },
      "sumo_element": "interval",
      "sumo_child_element": "closingReroute"
    },
    {
      "parameter_name": "allowed_vehicle_types",
      "parameter_type": "enum_array",
      "description": "允许通行的车型（紧急关闭时应留空 = 禁止所有车型。仅在特殊情况下允许特种车辆通过）",
      "required": false,
      "default_value": [],
      "unit": null,
      "enum_values": [
        {"value": "passenger", "label": "客车", "disabled": "true"},
        {"value": "truck", "label": "货车", "disabled": "true"},
        {"value": "delivery", "label": "特种车辆", "disabled": "false"}
      ],
      "note": "推荐留空（关闭所有车型）。仅在极特殊情况下允许特种车辆通过"
    },
    {
      "parameter_name": "closure_reason",
      "parameter_type": "enum",
      "description": "关闭原因（用于文档和事件管理）",
      "required": false,
      "default_value": "emergency",
      "enum_values": [
        {"value": "accident", "label": "严重交通事故"},
        {"value": "facility_failure", "label": "设施故障"},
        {"value": "natural_disaster", "label": "自然灾害"},
        {"value": "emergency_event", "label": "应急情况"},
        {"value": "emergency", "label": "应急情况（通用）"}
      ]
    },
    {
      "parameter_name": "expected_duration_hours",
      "parameter_type": "number",
      "description": "预期持续时长（仅用于文档和提醒）",
      "required": false,
      "default_value": 2,
      "min_value": 0.5,
      "max_value": 24,
      "unit": "小时"
    }
  ],
  "critical_warnings": [
    "⚠️ 紧急关闭会阻挡所有车辆，可能造成严重后果 - 仅在必要时使用",
    "⚠️ 确保存在充足的替代入口可供车辆进入",
    "⚠️ 此操作可能导致关闭入口上游积压大量车辆",
    "⚠️ 建议提前通知相关部门和用户（交通部门、导航应用等）",
    "⚠️ 关闭期间监控相关路段的交通流状态和替代路由的压力"
  ],
  "best_practices": {
    "assessment": "在执行前充分评估替代入口的容量和周边路网的承载力",
    "timing": "避免在高峰时段执行；建议选择相对较低流量的时间",
    "duration": "关闭时长通常1-4小时；较长时间可能需要其他管理措施或应急疏导",
    "communication": "与交通管理部门、高速公路运营方协调；考虑发布交通预警和导航提示",
    "monitoring": "关闭期间实时监控：关闭入口上游队列长度、替代入口和路线流量、应急车道和匝道压力",
    "escalation": "如果替代路由出现严重拥堵，考虑部分恢复入口或启用应急车道"
  },
  "notes": {
    "renamed_from": "tec_closure_complete",
    "reason": "重命名为 tec_emergency_closure 更清晰地表达仅用于紧急情况的设计意图，避免与日常的关闭策略混淆"
  },
  "created_at": "2025-10-25T00:00:00Z",
  "updated_at": "2025-10-25T00:00:00Z"
}
