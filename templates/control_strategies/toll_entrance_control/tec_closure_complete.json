{
  "template_id": "tec_closure_complete",
  "template_name": "收费入口 - 完全关闭",
  "description": "完全关闭一个或多个收费站入口，所有车辆都被禁止进入并自动重新路由。适用于应急情况、维护作业或需要完全阻止某些入口的场景。",
  "strategy_type": "TEC",
  "sumo_element": "rerouter",
  "version": "2.0",
  "parameters_schema": [
    {
      "parameter_name": "entrance_edges",
      "parameter_type": "edge_array",
      "description": "要完全关闭的入口edge ID列表（支持多个入口）",
      "required": true,
      "default_value": [],
      "unit": null,
      "sumo_mapping": "edges (直接使用)"
    },
    {
      "parameter_name": "closure_intervals",
      "parameter_type": "tec_interval_array",
      "description": "完全关闭的时间区间列表（建议每次关闭1-4小时）",
      "required": true,
      "default_value": [
        {"begin_hours": 7, "end_hours": 9}
      ],
      "unit": null,
      "constraints": {
        "min_intervals": 1,
        "max_intervals": 10,
        "recommended_duration_hours": "1-4"
      },
      "interval_structure": {
        "begin_display_unit": "hours",
        "begin_sumo_unit": "seconds",
        "begin_conversion_factor": 3600,
        "end_display_unit": "hours",
        "end_sumo_unit": "seconds",
        "end_conversion_factor": 3600
      },
      "sumo_element": "interval",
      "sumo_child_element": "closingReroute"
    },
    {
      "parameter_name": "allowed_vehicle_types",
      "parameter_type": "enum_array",
      "description": "允许通行的车型（完全关闭时应留空 = 禁止所有车型）",
      "required": false,
      "default_value": [],
      "unit": null,
      "enum_values": [
        {"value": "passenger", "label": "乘用车 (客车)"},
        {"value": "bus", "label": "公交车"},
        {"value": "truck", "label": "货车"},
        {"value": "emergency", "label": "应急车"}
      ],
      "note": "空列表 = 完全关闭（所有车型禁止）。仅在特殊情况下允许emergency车通过"
    },
    {
      "parameter_name": "closure_reason",
      "parameter_type": "enum",
      "description": "关闭原因（用于文档和事件管理）",
      "required": false,
      "default_value": "emergency",
      "enum_values": [
        {"value": "maintenance", "label": "维护作业"},
        {"value": "emergency", "label": "应急情况"},
        {"value": "congestion_relief", "label": "拥堵缓解"}
      ]
    },
    {
      "parameter_name": "expected_duration_hours",
      "parameter_type": "number",
      "description": "预期持续时长（仅用于文档）",
      "required": false,
      "default_value": 2,
      "min_value": 0.5,
      "max_value": 24,
      "unit": "小时"
    }
  ],
  "critical_warnings": [
    "⚠️ 完全关闭会阻挡所有车辆，可能造成严重后果 - 仅在必要时使用",
    "⚠️ 确保存在充足的替代入口可供车辆进入",
    "⚠️ 此操作可能导致关闭入口上游积压大量车辆",
    "⚠️ 建议提前通知相关部门和用户",
    "⚠️ 监控替代入口和路线的交通状态"
  ],
  "best_practices": {
    "timing": "避免在高峰时段关闭；建议选择非高峰时间",
    "duration": "关闭时长通常1-4小时；较长时间可能需要其他管理措施",
    "communication": "与交通管理部门协调；考虑发布交通预警",
    "monitoring": "关闭期间监控相关路段的交通流状态"
  },
  "created_at": "2025-10-24T12:00:00Z",
  "updated_at": "2025-10-24T12:00:00Z"
}
