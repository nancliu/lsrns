{
  "template_id": "tec_entrance_close",
  "template_name": "收费入口 - 关闭",
  "description": "临时关闭特定收费站入口，禁止车辆进入。适用于应急情况、维护作业或需要完全减少流入的场景。被阻挡的车辆会自动重新路由至其他入口。",
  "strategy_type": "TEC",
  "sumo_element": "rerouter",
  "version": "2.0",
  "parameters_schema": [
    {
      "parameter_name": "entrance_edges",
      "parameter_type": "edge_array",
      "description": "需要关闭的收费站入口edge ID列表",
      "required": true,
      "default_value": [],
      "unit": null,
      "sumo_mapping": "edges (直接使用)"
    },
    {
      "parameter_name": "closure_intervals",
      "parameter_type": "tec_interval_array",
      "description": "入口关闭的时间区间列表",
      "required": true,
      "default_value": [
        {"begin_hours": 7, "end_hours": 9}
      ],
      "unit": null,
      "constraints": {
        "min_intervals": 1,
        "max_intervals": 10
      },
      "interval_structure": {
        "begin_display_unit": "hours",
        "begin_sumo_unit": "seconds",
        "begin_conversion_factor": 3600,
        "end_display_unit": "hours",
        "end_sumo_unit": "seconds",
        "end_conversion_factor": 3600
      },
      "sumo_element": "interval",
      "sumo_child_element": "closingReroute"
    },
    {
      "parameter_name": "allowed_vehicle_types",
      "parameter_type": "enum_array",
      "description": "允许通行的车辆类型（留空=完全关闭，所有车型禁止）",
      "required": false,
      "default_value": [],
      "unit": null,
      "enum_values": [
        {"value": "passenger", "label": "乘用车 (客车)"},
        {"value": "bus", "label": "公交车"},
        {"value": "truck", "label": "货车"},
        {"value": "emergency", "label": "应急车"}
      ],
      "note": "空列表表示完全关闭（所有车型禁止）"
    },
    {
      "parameter_name": "reason",
      "parameter_type": "enum",
      "description": "关闭原因（用于文档和系统管理）",
      "required": false,
      "default_value": "emergency",
      "enum_values": [
        {"value": "maintenance", "label": "维护作业"},
        {"value": "emergency", "label": "应急情况"},
        {"value": "congestion_relief", "label": "拥堵缓解"}
      ]
    }
  ],
  "warnings": [
    "完全关闭会阻挡所有车辆 - 确保存在可用的替代入口",
    "此操作可能导致被阻挡车辆聚集在上游或其他入口",
    "建议关闭时长1-4小时"
  ],
  "created_at": "2025-10-19T00:00:00Z",
  "updated_at": "2025-10-24T12:00:00Z"
}
