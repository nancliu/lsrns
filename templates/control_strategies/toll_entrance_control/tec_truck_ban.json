{
  "template_id": "tec_truck_ban",
  "template_name": "收费入口 - 货车限行",
  "description": "在指定时段禁止货车进入特定收费站，减少大型车辆对交通流的影响。适用于客运为主的时段，通过限制货车进口流来提高小车流畅性。",
  "strategy_type": "TEC",
  "sumo_element": "rerouter",
  "version": "2.0",
  "parameters_schema": [
    {
      "parameter_name": "entrance_edges",
      "parameter_type": "edge_array",
      "description": "受管控的收费站入口edge ID列表（支持1-3个收费站）",
      "required": true,
      "default_value": [],
      "unit": null,
      "sumo_mapping": "edges (直接使用)"
    },
    {
      "parameter_name": "restriction_intervals",
      "parameter_type": "array",
      "description": "货车禁入的时间区间",
      "required": true,
      "default_value": [
        {"begin_hours": 7, "end_hours": 9},
        {"begin_hours": 17, "end_hours": 19}
      ],
      "unit": null,
      "constraints": {
        "min_intervals": 1,
        "max_intervals": 10
      },
      "interval_structure": {
        "begin_display_unit": "hours",
        "begin_sumo_unit": "seconds",
        "begin_conversion_factor": 3600,
        "end_display_unit": "hours",
        "end_sumo_unit": "seconds",
        "end_conversion_factor": 3600
      },
      "sumo_element": "interval",
      "sumo_child_element": "closingReroute"
    },
    {
      "parameter_name": "disallow_vehicle_types",
      "parameter_type": "enum_array",
      "description": "禁止进入的车辆类型",
      "required": true,
      "default_value": ["truck"],
      "unit": null,
      "enum_values": [
        {"value": "passenger", "label": "乘用车 (客车)", "disabled": true},
        {"value": "bus", "label": "公交车", "disabled": true},
        {"value": "truck", "label": "货车", "disabled": false},
        {"value": "emergency", "label": "应急车", "disabled": true}
      ],
      "note": "通常禁止truck和trailer;passenger/bus/emergency总是允许",
      "sumo_mapping": "disallow 属性"
    },
    {
      "parameter_name": "restriction_pattern",
      "parameter_type": "enum",
      "description": "限行模式",
      "required": false,
      "default_value": "peak_only",
      "enum_values": [
        {"value": "full_day", "label": "全天禁行"},
        {"value": "peak_only", "label": "仅高峰禁行"},
        {"value": "custom", "label": "自定义时段"}
      ]
    }
  ],
  "warnings": [
    "货车禁限可能导致货车经由其他收费站进入，造成那些收费站拥堵",
    "建议配合整体网络流量分析，避免转移拥堵到周边路线",
    "监控替代路由的交通状态"
  ],
  "created_at": "2025-10-19T00:00:00Z",
  "updated_at": "2025-10-24T12:00:00Z"
}
