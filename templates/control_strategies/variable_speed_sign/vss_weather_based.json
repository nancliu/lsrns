        {"time_hours": 8, "speed_kmh": 80},
        {"time_hours": 10, "speed_kmh": 60},
        {"time_hours": 14, "speed_kmh": 100},
        {"time_hours": 16, "speed_kmh": 120}
      ],
      "unit": null,
      "constraints": {
        "min_steps": 2,
        "max_steps": 10
      },
      "step_structure": {
        "time_display_unit": "hours",
        "time_sumo_unit": "seconds",
        "time_conversion_factor": 3600,
        "speed_display_unit": "km/h",
        "speed_sumo_unit": "m/s",
        "speed_conversion_factor": 0.277778,
        "speed_min": 30,
        "speed_max": 130
      },
      "sumo_element": "step",
      "sumo_attributes": ["time", "speed"]
    }
  ],
