{
  "config_id": "unit_conversions",
  "config_name": "单位转换配置",
  "description": "策略模板中使用的单位转换因子和约束定义",
  "version": "1.0",
  "conversions": {
    "time": {
      "display_unit": "hours",
      "sumo_unit": "seconds",
      "conversion_factor": 3600,
      "description": "时间单位转换：小时 → 秒",
      "formula": "seconds = hours × 3600"
    },
    "speed": {
      "display_unit": "km/h",
      "sumo_unit": "m/s",
      "conversion_factor": 0.277778,
      "description": "速度单位转换：千米/小时 → 米/秒",
      "formula": "m/s = km/h × 0.277778 (即 km/h ÷ 3.6)",
      "inverse_formula": "km/h = m/s × 3.6"
    },
    "distance": {
      "display_unit": "meters",
      "sumo_unit": "meters",
      "conversion_factor": 1,
      "description": "距离单位：米（SUMO和显示单位相同）"
    }
  },
  "constraints": {
    "speed": {
      "min": 30,
      "max": 130,
      "unit": "km/h",
      "description": "速度限制的有效范围（高速公路场景）",
      "notes": "低于30 km/h可能导致交通流不稳定，高于130 km/h超出高速公路设计速度"
    },
    "time_hours": {
      "min": 0,
      "max": 24,
      "unit": "hours",
      "description": "24小时制时间范围"
    },
    "flow_rate": {
      "min": 0,
      "max": 2400,
      "unit": "vehicles/hour",
      "description": "单车道每小时流量的合理范围",
      "notes": "理论最大流量约2400 veh/hr/lane，实际通常不超过2000"
    }
  },
