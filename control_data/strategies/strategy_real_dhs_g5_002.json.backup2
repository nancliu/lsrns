  "template": {
    "template_id": "dhs_peak_multi_interval",
    "template_name": "应急车道 - 多时段管理",
    "description": "复杂的多时段应急车道管理方案，通过5+个时间段在24小时内精确控制应急车道的开放与关闭，实现最优的流量管理。模式：夜间关闭→早高峰开放→平峰关闭→晚高峰开放→夜间关闭。",
    "extends": "dhs_base",
    "version": "2.1",
    "parameters_schema": [
      {
        "parameter_name": "affected_edges",
        "parameter_type": "edge_array",
        "description": "受应急车道控制影响的路段edge ID列表（应形成连续区间）",
        "required": true,
        "default_value": [],
        "unit": null,
        "sumo_mapping": "edges (直接使用)"
      },
      {
        "parameter_name": "hard_shoulder_lane_index",
        "parameter_type": "integer",
        "description": "应急车道索引（SUMO中索引0为最右侧车道，即硬路肩）",
        "required": false,
        "default_value": 0,
        "min_value": 0,
        "max_value": 7,
        "unit": null,
        "note": "SUMO车道编号：0=最右侧（硬路肩），递增向左。4车道公路中：0为硬路肩，3为最左侧车道"
      },
      {
        "parameter_name": "intervals",
        "parameter_type": "dhs_interval_array",
        "description": "5个及以上精确的时间段定义（最少5个），必须完整覆盖24小时（0-24），无缝隙或重叠",
        "constraints": {
          "min_intervals": 5,
          "max_intervals": 10,
          "coverage": "必须覆盖完整24小时(0-24)，无缝隙或重叠"
        },
        "required": true
      },
      {
        "parameter_name": "allowed_vehicle_types",
        "parameter_type": "enum_array",
        "description": "应急车道开放时允许通行的车辆类型（全局默认值，可被时间区间的值覆盖）",
        "required": false,
        "default_value": [
          "passenger",
          "truck",
          "delivery"
        ],
        "unit": null,
        "enum_values": [
          {
            "value": "passenger",
            "label": "客车"
          },
          {
            "value": "truck",
            "label": "货车"
          },
          {
            "value": "delivery",
            "label": "特种车辆"
          }
        ],
        "sumo_mapping": "allow 属性",
        "note": "此参数定义应急车道开放时的默认允许车型。实际使用时，每个时间区间可设置自己的allowed_vehicle_types"
      }
    ],
    "creation_guidance": {
      "preset_pattern": "默认标准模式：早(07-09) + 晚(17-19)高峰各2小时开放",
      "customization": "用户可在每个interval中调整开放/关闭和允许的车型",
      "timeline_visualization": "UI应显示24小时时间线，标记开放(绿色)和关闭(灰色)区间"
    },
    "created_at": "2025-10-24T12:00:00Z",
    "updated_at": "2025-10-29T00:00:00Z"
  }
}