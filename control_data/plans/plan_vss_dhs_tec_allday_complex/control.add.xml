<additional xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/additional_file.xsd">

    <!-- ==================== TEC策略组（第一层：上游入口控制） ==================== -->

    <!-- 策略: strategy_real_tec_g5_001 - G5成雅双流南站入口流量控制 -->
    <!-- 功能：源头控制进入主线的车辆数量，防止拥堵路段过载 -->
    <calibrator id="tec_strategy_real_tec_g5_001" edge="-1232" pos="0">
        <!-- 0:00-6:00: 平峰期，正常通行 300 veh/hr -->
        <flow begin="0" end="21600" vehsPerHour="300" speed="15"/>
        <!-- 6:00-10:00: 早高峰，严格限流 120 veh/hr（削减60%） -->
        <flow begin="21600" end="36000" vehsPerHour="120" speed="8"/>
        <!-- 10:00-16:00: 白天平峰，中等限流 250 veh/hr -->
        <flow begin="36000" end="57600" vehsPerHour="250" speed="12"/>
        <!-- 16:00-20:00: 晚高峰，极严限流 100 veh/hr（削减68%） -->
        <flow begin="57600" end="72000" vehsPerHour="100" speed="6"/>
        <!-- 20:00-24:00: 夜间平峰，正常通行 300 veh/hr -->
        <flow begin="72000" end="86400" vehsPerHour="300" speed="15"/>
    </calibrator>

