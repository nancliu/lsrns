    <!-- ==================== DHS策略组（第三层：应急车道扩容） ==================== -->

    <!-- 策略: strategy_real_dhs_g5_002 - G5成雅双流段高峰应急车道开放 -->
    <!-- 功能：增加通行能力，疏导车流，配合VSS限速确保安全 -->
    <rerouter id="dhs_strategy_real_dhs_g5_002" edges="-8174 -14036 -7854 -15664 -4878 -13916 -10274 -2092 -9480 -11518 -4878.749 -4878.924 -14628 -6476">
        <!-- 0:00-7:00: 应急车道关闭，仅应急车辆 -->
        <interval begin="0" end="25200">
            <closingLaneReroute id="hard_shoulder_0" allow="emergency"/>
