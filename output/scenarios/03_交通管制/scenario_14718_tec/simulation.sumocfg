<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="D:/projects/OD_SIM/templates/network_files/sichuan202508v7.net.xml"/>
        <additional-files value="D:/projects/OD_SIM/output/scenarios/03_交通管制/scenario_14718_tec/scenario_交通管制_tec_14718.add.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="8820"/>
        <step-length value="1.0"/>
    </time>

    <output>
        <summary-file value="results/summary.xml"/>
        <tripinfo-output value="results/tripinfo.xml"/>
        <vehroute-output value="results/vehroute.xml"/>
