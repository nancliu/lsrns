{
  "name": "od-sim-frontend-tests",
  "version": "1.0.0",
  "description": "Frontend E2E tests for OD_SIM",
  "scripts": {
    "test": "mocha frontend/tests/unit/*.test.js --require frontend/tests/unit/test-setup.js --timeout 5000",
    "test:day1": "mocha frontend/tests/unit/updateConfigSummary.test.js --require frontend/tests/unit/test-setup.js --timeout 5000",
    "test:day2": "mocha frontend/tests/unit/parameterControls.test.js --require frontend/tests/unit/test-setup.js --timeout 5000",
    "test:day3": "mocha frontend/tests/unit/integrationTests.test.js --require frontend/tests/unit/test-setup.js --timeout 5000",
    "test:day4-5": "mocha frontend/tests/unit/createStrategyTests.test.js --require frontend/tests/unit/test-setup.js --timeout 5000",
    "test:day4-5-integration": "mocha frontend/tests/unit/createStrategyIntegration.test.js --require frontend/tests/unit/test-setup.js --timeout 5000",
    "test:integration": "mocha frontend/tests/unit/integrationTests.test.js --require frontend/tests/unit/test-setup.js --timeout 5000",
    "test:viz": "playwright test tests/frontend/test_visualization_performance.spec.js",
    "test:viz:headed": "playwright test tests/frontend/test_visualization_performance.spec.js --headed",
    "test:viz:debug": "playwright test tests/frontend/test_visualization_performance.spec.js --debug"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "chai": "^6.2.0",
    "jsdom": "^27.0.1",
    "mocha": "^11.7.4",
    "sinon": "^19.0.5"
  }
}
